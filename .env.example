BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_TIMEOUT_SECONDS=120
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_HASH_KEY=
DATABASE_URL=sqlite:///./dev.db
FIELD_ENCRYPTION_KEY=
STORAGE_DIR=./storage
APP_BASE_URL=http://localhost:3000
# Web app (apps/web): where its /api proxy forwards. Server-side only, not a secret.
API_ORIGIN=http://localhost:8000
# Leave unset: the browser then calls /api on the web origin and the session cookie stays
# first-party. Set it only to point the browser straight at an API in local experiments.
NEXT_PUBLIC_API_URL=
