<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ l.title }}</title>
<meta name="generator" content="UnSeal">
<meta name="dcterms.created" content="{{ doc.prepared_on.isoformat() }}">
<meta name="dcterms.modified" content="{{ doc.prepared_on.isoformat() }}">
<style>
{% for face in font_faces %}
@font-face {
  font-family: "{{ face.family }}";
  font-style: normal;
  font-weight: {{ face.weight }};
  src: url("{{ face.url }}") format("truetype");
}
{% endfor %}

@page {
  size: A4;
  margin: 19mm 20mm 30mm 20mm;
  @bottom-center {
    content: element(page-footer);
    width: 170mm;
    vertical-align: top;
    padding-top: 3mm;
  }
}

/* Noto Sans also carries Devanagari, so the script font of the letter comes first for hi and ta:
   without that the Devanagari font would never be used. English runs inside a Hindi or Tamil
   letter carry lang="en" and go back to Noto Sans. No letter-spacing anywhere: it breaks shaping. */
html {
  font-family: "Noto Sans", "Noto Sans Tamil", "Noto Sans Devanagari", sans-serif;
  font-size: 11.5pt;
  line-height: 1.6;
  color: #111;
  background: #fff;
}
:lang(hi) { font-family: "Noto Sans Devanagari", "Noto Sans", "Noto Sans Tamil", sans-serif; }
:lang(ta) { font-family: "Noto Sans Tamil", "Noto Sans", "Noto Sans Devanagari", sans-serif; }
:lang(en) { font-family: "Noto Sans", "Noto Sans Tamil", "Noto Sans Devanagari", sans-serif; }

body { margin: 0; }
main { overflow-wrap: anywhere; }
p { margin: 0 0 2.5mm; }
h1 { font-size: 14pt; font-weight: 700; line-height: 1.5; text-align: center; margin: 0 0 7mm; }
address { font-style: normal; }
address p { margin: 0; }
.to-label { margin: 0 0 1mm; font-weight: 700; }
.multiline { white-space: pre-line; }
.subject { margin-top: 6mm; }
.subject strong, dt { font-weight: 700; }
.request { margin-top: 4mm; break-after: avoid; }

ol.questions { margin: 0 0 5mm; padding-left: 9mm; }
ol.questions li { margin-bottom: 2.5mm; padding-left: 1mm; break-inside: avoid; }
ol.questions li:last-child { break-after: avoid; }

dl.details { display: table; margin: 0; }
dl.details > div { display: table-row; }
dl.details dt, dl.details dd { display: table-cell; margin: 0; padding: 0.8mm 0; vertical-align: top; }
dl.details dt { padding-right: 6mm; white-space: nowrap; }
dl.details .sign-row dt, dl.details .sign-row dd { vertical-align: bottom; }
.signature-line { display: block; width: 52mm; height: 13mm; border-bottom: 0.6pt solid #111; }
.note { margin: 2mm 0 0; }

.tail { break-inside: avoid; }
.closing { margin-top: 6mm; }
.sign-block { display: table; width: 100%; margin-top: 1mm; }
.sign-left, .sign-right { display: table-cell; vertical-align: bottom; }
.sign-left { width: 60mm; }

.page-footer {
  position: running(page-footer);
  border-top: 0.5pt solid #777;
  padding-top: 2mm;
  font-size: 10.5pt;
  line-height: 1.5;
  text-align: center;
  color: #333;
}
.page-footer p { margin: 0; }
</style>
</head>
<body>
<footer class="page-footer">
<p lang="en">Prepared with UnSeal. Not legal advice.</p>
{% if l.footer_local %}
<p>{{ l.footer_local }}</p>
{% endif %}
</footer>

<main>
<h1>{{ l.title }}</h1>

<section class="to">
<p class="to-label">{{ l.to }}</p>
<address>
<p>{{ l.officer }},</p>
<p>{{ run(doc.authority_name) }}</p>
<p class="multiline">{{ run(doc.pio_address) }}</p>
</address>
</section>

<p class="subject"><strong>{{ l.subject }}:</strong> {{ run(doc.subject) }}</p>

<p class="request">{{ l.salutation }}</p>
<p class="request">{{ l.request }}</p>

<ol class="questions">
{% for question in doc.questions %}
<li class="multiline">{{ run(question) }}</li>
{% endfor %}
</ol>

<section class="tail">
<dl class="details fee">
<div><dt>{{ l.fee }}</dt><dd>{{ fee_text }}</dd></div>
{% if payment_text %}
<div><dt>{{ l.payment_mode }}</dt><dd>{{ run(payment_text) }}</dd></div>
{% endif %}
</dl>
{% if show_certificate_note %}
<p class="note">{{ l.bpl_note }}</p>
{% endif %}

<section class="closing">
<p>{{ l.closing }}</p>
<div class="sign-block">
<div class="sign-left">
<dl class="details">
<div><dt>{{ l.date }}</dt><dd><time datetime="{{ doc.prepared_on.isoformat() }}">{{ date_text }}</time></dd></div>
{% if doc.place.strip() %}
<div><dt>{{ l.place }}</dt><dd>{{ run(doc.place) }}</dd></div>
{% endif %}
</dl>
</div>
<div class="sign-right">
<dl class="details">
<div class="sign-row"><dt>{{ l.signature }}</dt><dd><span class="signature-line" aria-hidden="true"></span></dd></div>
<div><dt>{{ l.applicant }}</dt><dd>{{ run(doc.applicant_name) }}</dd></div>
<div><dt>{{ l.address }}</dt><dd class="multiline">{{ run(doc.applicant_address) }}</dd></div>
</dl>
</div>
</div>
</section>
</section>
</main>
</body>
</html>
