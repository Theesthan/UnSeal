# Server-side only (no NEXT_PUBLIC_ prefix): where Next.js forwards /api/*, the UnSeal API.
# Read at build time. Not a secret, and never sent to the browser.
API_ORIGIN=http://localhost:8000

# Optional and public (shipped to the browser): call an API directly instead of /api. Leave it
# unset in production so the session cookie stays first-party.
# NEXT_PUBLIC_API_URL=
